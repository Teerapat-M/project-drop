# Copy into the relevant app directory. Never commit real secrets.

# --- Mobile (apps/mobile/.env) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_ENABLE_PHONE_OTP=false

# --- Server (apps/server/.env) ---
PORT=3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Optional HS256 fallback (legacy projects). Prefer JWKS at SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
# Optional. Set on Render by Bell. Not required for GET /me.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin (apps/admin/.env.local) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
