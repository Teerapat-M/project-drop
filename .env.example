# Copy into the relevant app directory. Never commit real secrets.

# --- Mobile (apps/mobile/.env) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_ENABLE_PHONE_OTP=false
EXPO_PUBLIC_API_URL=http://localhost:3001
# Free OSM-compatible MapLibre style (OpenFreeMap liberty, or https://demotiles.maplibre.org/style.json).
# Attribution: © OpenStreetMap contributors · OpenFreeMap
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_GEOCODER_URL=https://photon.komoot.io/api
EXPO_PUBLIC_OSRM_URL=https://router.project-osrm.org

# --- Server (apps/server/.env) ---
PORT=3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Optional HS256 fallback (legacy projects). Prefer JWKS at SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
# Optional. Set on Render by Bell. Needed to persist translated_text (service role insert).
# Trip PIN still uses verify_trip_pin() without it; chat originals still deliver via the user JWT.
SUPABASE_SERVICE_ROLE_KEY=
# Translation (server only). Never put these in the Expo app.
# Gemini free-tier key: https://aistudio.google.com/apikey (no credit card).
GEMINI_API_KEY=
# Optional. Default gemini-3.5-flash-lite (free-tier Flash-Lite).
GEMINI_MODEL=
# Optional. gemini | mymemory | none. Default: gemini if GEMINI_API_KEY is set, else mymemory.
TRANSLATION_PROVIDER=
# Optional. MyMemory `de` email for 50,000 chars/day (https://mymemory.translated.net/doc/usagelimits.php).
MYMEMORY_EMAIL=
# Optional. Default 2500.
TRANSLATION_TIMEOUT_MS=

# --- Admin (apps/admin/.env.local) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
