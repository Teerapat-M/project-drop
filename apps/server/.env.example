PORT=3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Optional. Used to verify legacy HS256 access tokens when JWKS is empty.
SUPABASE_JWT_SECRET=
# Optional. Bell sets this on Render. Used to persist translated chat columns.
# Not required for /me or trip PIN (verify_trip_pin RPC). Without it, chat still
# delivers original_text (translated_text stays null).
SUPABASE_SERVICE_ROLE_KEY=
# Server-side translation only. Never commit a real key. Never expose to Expo.
GEMINI_API_KEY=
GEMINI_MODEL=
TRANSLATION_PROVIDER=
MYMEMORY_EMAIL=
TRANSLATION_TIMEOUT_MS=
