{
  "name": "@drop/server",
  "version": "0.1.0",
  "private": true,
  "description": "Drop API (Express)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.cjs && tsx --test src/auth/verifyJwt.jose.spec.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@drop/types": "*",
    "@supabase/supabase-js": "^2.86.0",
    "express": "^5.1.0",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.15",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.4"
  }
}
