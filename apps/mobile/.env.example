EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Phone OTP needs an SMS provider on the Supabase project. Leave false until then.
EXPO_PUBLIC_ENABLE_PHONE_OTP=false
# Express API (Android emulator: http://10.0.2.2:3001)
EXPO_PUBLIC_API_URL=http://localhost:3001
# Free OSM-compatible MapLibre style. No API key. OpenFreeMap or MapLibre demotiles.
# Attribution: © OpenStreetMap contributors · OpenFreeMap
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Photon (default) or Nominatim. Identify Drop via User-Agent; 500ms debounce; min 3 chars.
EXPO_PUBLIC_GEOCODER_URL=https://photon.komoot.io/api
# OSRM route preview. Default is the public demo server.
EXPO_PUBLIC_OSRM_URL=https://router.project-osrm.org
